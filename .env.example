# Copy to `.env` and fill in. `.env` is gitignored — never commit real secrets.
# Generate secrets with: openssl rand -hex 32

# --- Postgres ---
POSTGRES_USER=bdash
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=business_dashboard

# --- Published host ports (bound to 127.0.0.1 only) ---
WEB_PORT=54331
API_PORT=54330
DB_PORT=54329

# --- API write token ---
# The nginx proxy injects this as `Authorization: Bearer <token>`; the api
# enforces it. The browser never sees it. Required in production.
API_TOKEN=change-me-64-hex-token

# Upstream the web proxy forwards to (compose network), and CORS allow-list for
# the direct/dev path (Vite on :5173 hitting the api directly).
API_UPSTREAM=http://api:3000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://businessdashboard.agencyadvanta.com

# --- Baked into the SPA at build time (safe to expose) ---
VITE_API_URL=/api/external/kv
# The ONE shared workspace both users land in (so Josiah + Joanna sync together).
VITE_WORKSPACE_KEY=bd-agencyadvanta-shared

# --- MCP connector (Claude / ChatGPT) ---
# ONE secret runs the whole connector. It is the access key on the OAuth login
# page AND, on its own, a valid `Authorization: Bearer <key>` for CLI clients
# that can't do OAuth. Leave it EMPTY to not mount /mcp at all.
#   openssl rand -hex 32
MCP_SECRET_KEY=

# Public origin the connector is reached at — the OAuth issuer and the audience
# baked into every token. Origin root only: no trailing slash, no path.
# Changing it invalidates tokens already issued (clients just re-authorize).
MCP_PUBLIC_URL=https://businessdashboard.agencyadvanta.com

# Optional (defaults shown). MCP_WORKSPACE_KEY defaults to VITE_WORKSPACE_KEY.
# MCP_WORKSPACE_KEY=bd-agencyadvanta-shared
# MCP_ALLOW_WRITES=1          # 0 = read-only connector (write tools disappear)
# MCP_ALLOW_SQL=1             # 0 = hide query_sql / list_tables / describe_table
# MCP_ALLOW_STATIC_TOKEN=1    # 0 = force every client through the OAuth flow
# MCP_RATE_LIMIT_PER_MINUTE=120

# --- Dev only — leave UNSET in production (would expose the token in the bundle) ---
# VITE_API_TOKEN=
